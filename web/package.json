{
  "name": "evergate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test tests/modelSelection.test.ts tests/playgroundProtocol.test.ts tests/channelPresets.test.ts tests/runtime.test.ts tests/i18n.test.ts tests/errorCodes.test.ts tests/usageBucket.test.ts tests/localDate.test.ts",
    "test:ui": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "audit:layout": "node scripts/layout-audit.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "1.8.1",
    "react": "^19.0.0",
    "react-aria-components": "1.22.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.0.0",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "^7.92.0",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.10.1",
    "shadcn": "4.23.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.2"
  }
}
